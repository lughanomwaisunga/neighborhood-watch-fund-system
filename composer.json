{
  "name": "lughanomwaisunga/neighborhood-watch-fund-system",
  "description": "A PHP/MySQL fund collection system for Neighborhood Watch",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Lughan Omwaisunga",
      "email": "lughanomwaisunga@example.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "vlucas/phpdotenv": "^5.4",
    "guzzlehttp/guzzle": "^7.0",
    "mpdf/mpdf": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 public/index.php",
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 src/"
  }
