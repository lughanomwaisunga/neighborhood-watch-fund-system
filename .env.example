# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=neighborhood_watch
DB_PORT=3306

# Application Settings
APP_NAME=Neighborhood Watch Fund System
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Payment Gateway Configuration

# Mpamba API
MPAMBA_API_KEY=your_mpamba_api_key
MPAMBA_API_SECRET=your_mpamba_api_secret
MPAMBA_API_URL=https://api.mpamba.com
MPAMBA_CALLBACK_URL=http://localhost:8000/callbacks/mpamba

# Airtel Money API
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_API_URL=https://api.airtel.money
AIRTEL_CALLBACK_URL=http://localhost:8000/callbacks/airtel

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=noreply@neighborhoodwatch.local
MAIL_FROM_NAME=Neighborhood Watch
